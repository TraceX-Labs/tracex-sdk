{
  "name": "@tracexpro/browser",
  "version": "0.2.0",
  "description": "TraceX for the browser: errors, unhandled rejections and failed API calls, grouped into issues in TraceX.",
  "license": "MIT",
  "homepage": "https://docs.tracexpro.com/errors/",
  "keywords": [
    "error-tracking",
    "monitoring",
    "tracex",
    "browser"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraceX-Labs/tracex-sdk.git",
    "directory": "packages/browser"
  }
}
